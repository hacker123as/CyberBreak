<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>CyberBreak Project</vendor>
  <vendor_url>https://github.com/hacker123as/CyberBreak</vendor_url>
  <icon_name>cyberbreak</icon_name>

  <action id="org.cyberbreak.security.helper">
    <description>CyberBreak Security Operations</description>
    <message>Authentication is required to execute CyberBreak security operations</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/cyberbreak/cyberbreak-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>

  <action id="org.cyberbreak.security.libexec">
    <description>CyberBreak Security Operations (Libexec)</description>
    <message>Authentication is required to execute CyberBreak security operations</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/cyberbreak/cyberbreak-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
